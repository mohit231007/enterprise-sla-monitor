generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Branch {
  id           Int                @id @default(autoincrement())
  name         String             @unique
  region       String
  managerName  String             @map("manager_name")
  performance  DailyPerformance[]
  tickets      OperationsTicket[]

  @@map("branches")
}

model DailyPerformance {
  id             Int      @id @default(autoincrement())
  branchId       Int      @map("branch_id")
  date           DateTime
  revenue        Float
  revenueTarget  Float    @map("revenue_target")
  accountsOpened Int      @map("accounts_opened")
  loansProcessed Int      @map("loans_processed")
  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, date])
  @@index([date])
  @@map("daily_performance")
}

enum TicketType {
  Case
  Complaint
  Exception
}

enum TicketStatus {
  Open
  Closed
}

model OperationsTicket {
  id          Int          @id @default(autoincrement())
  branchId    Int          @map("branch_id")
  type        TicketType
  status      TicketStatus
  createdAt   DateTime     @map("created_at")
  resolvedAt  DateTime?    @map("resolved_at")
  slaBreached Boolean      @default(false) @map("sla_breached")
  externalTicketId String? @unique @map("external_ticket_id")
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, createdAt])
  @@index([status, type])
  @@map("operations_tickets")
}

enum IngestionSource {
  SEED
  DEMO_STREAM
  CSV_UPLOAD
}

enum IngestionStatus {
  RUNNING
  SUCCESS
  FAILED
}

model IngestionRun {
  id              Int             @id @default(autoincrement())
  source          IngestionSource
  status          IngestionStatus @default(RUNNING)
  startedAt       DateTime        @default(now()) @map("started_at")
  completedAt     DateTime?       @map("completed_at")
  recordsReceived Int             @default(0) @map("records_received")
  recordsAccepted Int             @default(0) @map("records_accepted")
  recordsRejected Int             @default(0) @map("records_rejected")
  latestEventAt   DateTime?       @map("latest_event_at")
  notes           String?

  @@index([startedAt])
  @@map("ingestion_runs")
}

model ReportSnapshot {
  id String @id
  createdAt DateTime @default(now()) @map("created_at")
  dateFrom DateTime @db.Date @map("date_from")
  dateTo DateTime @db.Date @map("date_to")
  ingestionRunIds Json @map("ingestion_run_ids")
  payload Json
  contentSha256 String @map("content_sha256")
  @@index([createdAt])
  @@map("report_snapshots")
}
